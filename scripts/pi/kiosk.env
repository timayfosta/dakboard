# Family Board kiosk settings (sourced by start-kiosk.sh / rotate-display.sh)
# Portrait rotation for a vertical TV:
#   right    = 90° CW   (use when left leaves the image upside-down)
#   left     = 90° CCW
#   normal   = no rotation (landscape monitor)
#   inverted = 180°
FAMILY_BOARD_ROTATE=right

# Mouse / trackpad testing on non-touch displays (1 = show cursor + mouse swipes)
FAMILY_BOARD_MOUSE=0

# Alt+F4 closes Chromium. systemd will not relaunch it after a clean exit.

# Optional: override start URL
# FAMILY_BOARD_URL=http://127.0.0.1:8765/screens/calendar.html?kiosk=1&mouse=1
