[Unit]
Description=Family Board Chromium kiosk
After=family-board-api.service graphical.target
Wants=family-board-api.service graphical.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=FAMILY_BOARD_SKIP_SERVER=1
WorkingDirectory=/home/pi/family-board-src
ExecStart=/home/pi/family-board-src/scripts/pi/start-kiosk.sh
Restart=always
RestartSec=12
StartLimitIntervalSec=0
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
